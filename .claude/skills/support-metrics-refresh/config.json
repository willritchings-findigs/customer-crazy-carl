{
  "_about": "Layer 2 (exact logic + configuration) for support-metrics-refresh. Every value here changes what gets computed or pushed; changed only by commit. Decisions: Will, 2026-11-12 (see T-tools/02-workflows/support-metrics-weekly-refresh.md).",
  "_config_version": "2026-11-12",
  "target": {
    "api_base": "https://findigs-growth-hub.base44.app/api",
    "app_id": "6a01dddd52a74acb4fd153bd",
    "entity": "SupportCache",
    "record_id": "6ab2a47fe51f717a0cccd58d",
    "cache_key": "support_overview",
    "dashboard_url": "https://findigs-growth-hub.base44.app/cx/support-metrics",
    "managed_fields": [
      "computed_at",
      "kpis",
      "by_channel",
      "by_category",
      "friction_themes",
      "trend_12wk",
      "by_priority",
      "by_agent",
      "priority_breakdown",
      "agent_breakdown",
      "priority_breakdown_by_segment",
      "agent_breakdown_by_segment",
      "by_category_by_segment",
      "by_category_by_segment_methodology",
      "tickets"
    ],
    "_managed_note": "The refresh owns these fields and rewrites them every run. Anything else on the record is left untouched; the read-back verify fails the run if anything else changed."
  },
  "window": {
    "trailing_days": 30,
    "_note": "Windows are [run date - N days, run date): the run date itself is excluded (partial day). d30 and d7 match the page's 30d / 7d columns.",
    "date_placeholders": {
      "anchor": 0,
      "d7_start": -7,
      "d30_start": -30,
      "d90_start": -90,
      "trend_start": -84
    }
  },
  "sql_fragments": {
    "_note": "Shared SQL; see shared/sql/README.md.",
    "pylon_base": "shared/sql/pylon_base.sql",
    "pet_ticket": "shared/sql/pet_ticket.sql",
    "segment": "shared/sql/support_segment.sql"
  },
  "sigma": {
    "data_model_id": "d8c49faf-458b-4407-bdc3-85a9fbefb609",
    "elements": {
      "support_cases_bi": {
        "id": "Gz0-jqrI1V",
        "column_prefix": "inode-1dBuhhkgQkWXslu27HE64N/",
        "columns": {
          "case_system": "dyE5lEXjiZ",
          "case_is_archived": "oZBsplPk2k",
          "is_test": "yKb4xRahxL",
          "case_user_type": "EqUUI_mZyt",
          "has_tech_escalation": "aXcJxyR08B",
          "csat": "00TvMgGarP"
        },
        "named_columns": [
          "CASE_IS_DELETED",
          "CREATED_AT",
          "CASE_CATEGORY",
          "CASE_SUB_CATEGORY",
          "CASE_SUBJECT",
          "CASE_ORIGIN",
          "CASE_STATUS",
          "CASE_PRIORITY",
          "CASE_OWNER",
          "CASE_NUMBER",
          "TICKET_TIME_TO_ASSIGNED_HOURS",
          "TICKET_RESOLUTION_HOURS",
          "ROLLUP_COMPANY_NAME"
        ]
      },
      "user_application_funnel": {
        "id": "apKoPbqWa9",
        "column_prefix": "inode-54xB1eUhLxf1EJucb7r8Xk/",
        "columns": {},
        "named_columns": [
          "FIRST_EVENT_AT"
        ]
      }
    },
    "queries": {
      "s1_kpis_segment": {
        "element": "support_cases_bi",
        "output": "s1_kpis_segment_<MMDD>.json",
        "purpose": "per requester segment: ticket counts, median first response and resolution, % handled without escalation, CSAT (pet excluded, spam included)"
      },
      "s2_kpis_all": {
        "element": "support_cases_bi",
        "output": "s2_kpis_all_<MMDD>.json",
        "purpose": "same KPIs for all tickets (medians can't be summed from segments)"
      },
      "s3_category_channel": {
        "element": "support_cases_bi",
        "output": "s3_category_channel_<MMDD>.json",
        "purpose": "ticket counts by category x channel (pet excluded, spam included; By Channel drops spam)"
      },
      "s4_pet_sla": {
        "element": "support_cases_bi",
        "output": "s4_pet_sla_<MMDD>.json",
        "purpose": "pet tickets only: answered within 24h / 4h, no first response, median first response"
      },
      "s5_sla_segment": {
        "element": "support_cases_bi",
        "output": "s5_sla_segment_<MMDD>.json",
        "purpose": "SLA within target by segment x channel (pet and spam excluded; no first response = miss)"
      },
      "s6_trend": {
        "element": "support_cases_bi",
        "output": "s6_trend_<MMDD>.json",
        "purpose": "12 weekly buckets ending the day before the run date"
      },
      "s7_funnel": {
        "element": "user_application_funnel",
        "output": "s7_funnel_<MMDD>.json",
        "purpose": "applicants who started an application: d30, d7 and the same 12 weekly buckets"
      },
      "s8_priority": {
        "element": "support_cases_bi",
        "output": "s8_priority_<MMDD>.json",
        "purpose": "d30 ticket and open counts by priority, for all tickets and per segment"
      },
      "s8_agents": {
        "element": "support_cases_bi",
        "output": "s8_agents_<MMDD>.json",
        "purpose": "d30 ticket/open counts and resolution hours by agent: top N per view (all, PM, applicant), plus Unassigned and Other, ranked in SQL"
      },
      "s9_category_segment": {
        "element": "support_cases_bi",
        "output": "s9_category_segment_<MMDD>.json",
        "purpose": "category counts by segment (d30, d7)"
      },
      "s10_needs_attention": {
        "element": "support_cases_bi",
        "output": "s10_needs_attention_<MMDD>.json",
        "purpose": "open tickets waiting on Findigs, created in the last 90 days, oldest first (50)"
      },
      "s11_open_backlog": {
        "element": "support_cases_bi",
        "output": "s11_open_backlog_<MMDD>.json",
        "purpose": "open tickets by status x age band x segment (stale count, sizing)"
      },
      "s12_friction": {
        "element": "support_cases_bi",
        "output": "s12_friction_<MMDD>.json",
        "purpose": "d30 ticket counts by category x friction theme (keyword rules below; spam excluded, pets category kept)"
      },
      "s13_user_types": {
        "element": "support_cases_bi",
        "output": "s13_user_types_<MMDD>.json",
        "purpose": "requester values the segment rule can't classify (pre-flight)"
      }
    }
  },
  "segments": {
    "reported": [
      "property_manager",
      "applicant"
    ],
    "all": [
      "property_manager",
      "applicant",
      "unset",
      "other"
    ],
    "max_other_share_pct": 1.0,
    "_note": "Rule in shared/sql/support_segment.sql. 'other' = values the rule can't classify (agent, realtor, new typos). The run lists them in the report and stops only if they exceed max_other_share_pct of d30 volume."
  },
  "spam_category": "spam",
