    "application_actions": "Application actions",
    "applicant_technical_issue": "Applicant technical issue",
    "denial_disputes": "Denial disputes",
    "payments_fees_finalization": "Payments, fees & finalization",
    "pm_technical_issue": "PM technical issue",
    "lease_details_change": "Lease details change",
    "uncategorized": "Uncategorized / other",
    "ticket": "Ticket (generic category)",
    "spam": "Spam",
    "prospect_inbound_sales": "Prospect inbound › sales",
    "quality_internal_comms": "Quality & internal comms",
    "consumer_report_requests": "Consumer report requests",
    "termwise": "Termwise",
    "conversation": "Conversation",
    "pets_disputes_consumer_requests": "Pets category, non-pet-verification"
  },
  "needs_attention": {
    "waiting_on_findigs_statuses": [
      "New",
      "Waiting on You",
      "On Engineering",
      "On Customer Success Team"
    ],
    "max_age_days": 90,
    "limit": 50,
    "ticket_url": "https://app.usepylon.com/issues?issueNumber={number}",
    "_decision": "Will, 2026-11-12: open tickets where the ball is in Findigs' court, created in the last 90 days, oldest first. Older ones are counted as stale backlog, not listed. Pet and spam excluded. Will, 2026-11-12 (second decision): property-manager and applicant requesters only; tickets with no requester type were mostly automated/internal email (Gong recaps, login codes, recruiting and reimbursement notices). They still count in the open-backlog numbers."
  },
  "breakdowns": {
    "top_agents": 10,
    "by_agent_rows": 20,
    "_note": "by_agent shows the top by_agent_rows (named) agents; agent_breakdown shows top_agents named + Unassigned + Other. s8_agents ranks the top by_agent_rows per view in SQL."
  },
  "sla": {
    "_decision": "Will, 2026-11-12 (honest version): share of tickets whose first response came within the channel's target; pet and spam excluded; a ticket with no first response counts as a miss. Replaces the 2026-09-28 method (answered tickets only, pet and spam included).",
    "include_unanswered_as_miss": true
  },
  "tickets_per_100_apps": {
    "_definition": "Pet- and spam-excluded tickets per 100 applicants who started an application (User Application Funnel, first event in the same window). Reproduces the 2026-09-28 values to within a point; applicant_only uses applicant tickets only."
  },
  "fcr": {
    "_definition": "Emma, 2026-09-22: share of closed tickets resolved in 2 or fewer agent replies. Pylon has no bulk touch count, so each run samples closed tickets through the Pylon connector (message history included) and scripts/fcr_sample.py counts agent replies.",
    "max_agent_replies": 2,
    "page_size": 100,
    "agent_reply": "message where from_customer is false, author_type is not 'system', and is_private is false",
    "exclude_tags": [
      "Spam"
    ],
    "sample_days_ago": [
      2,
      5,
      10,
      16,
      22,
      28
    ],
    "start_hour_utc": 13,
    "_sample_note": "One page per sampled day, oldest first from start_hour_utc (US morning). Days 2 and 5 form d7; all six form d30, each day weighted equally. Tickets with no public agent reply are left out of the rate."
  },
